# Copia este archivo como .env y pega tus claves reales (sin comillas).
# API-Football  -> https://www.api-football.com  (lesiones + XI confirmado)
API_FOOTBALL_KEY=tu_clave_de_api_football
# The Odds API  -> https://the-odds-api.com  (cuotas, 500 req/mes gratis)
ODDS_API_KEY=tu_clave_de_the_odds_api
# ElevenLabs (voz para los reels de TikTok) -> https://elevenlabs.io
ELEVENLABS_API_KEY=tu_clave_de_elevenlabs
ELEVENLABS_VOICE_ID=el_id_de_tu_voz_clonada
# Claude (Anthropic) para redactar el guion del día -> https://console.anthropic.com
ANTHROPIC_API_KEY=tu_clave_de_anthropic
# (opcional) email del digest via Resend -> https://resend.com
RESEND_API_KEY=
DIGEST_FROM=
DIGEST_TO=
